PORT=3000
NODE_ENV=development
API_PREFIX=/api/v1
# Optional: set to require X-Api-Key header on every request
API_KEY=

# ── Cloudflare Workers ───────────────────────────────────────────────────────
# Set secrets in Cloudflare instead of committing them here:
#   wrangler secret put API_KEY
#
# Deploy commands:
#   npm run dev:worker       — local Workers sandbox (port 8787)
#   npm run deploy:staging   — deploy to addd-staging worker
#   npm run deploy:production — deploy to addd-production worker
